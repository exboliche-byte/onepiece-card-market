{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/orb-image/:id",
      "destination": "https://optcg-api.arjunbansal-ai.workers.dev/images/:id"
    },
    {
      "source": "/orb-official/:id",
      "destination": "https://en.onepiece-cardgame.com/images/cardlist/card/:id.png"
    },
    {
      "source": "/card/:id",
      "destination": "/index.html"
    },
    {
      "source": "/set/:set",
      "destination": "/index.html"
    },
    {
      "source": "/deck/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "/orb-image/:id",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/orb-official/:id",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "buildCommand": "mkdir -p public && cp index.html scanner.js image-visibility.js public/"
}
