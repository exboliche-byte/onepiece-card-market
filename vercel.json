{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/card/:id",
      "destination": "/index.html"
    },
    {
      "source": "/set/:set",
      "destination": "/index.html"
    },
    {
      "source": "/deck/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    }
  ],
  "buildCommand": "node --test scripts/scanner-ocr.test.mjs scripts/scanner-vision.test.mjs && mkdir -p public && cp index.html scanner.js scanner-ocr.js scanner-vision.js image-visibility.js public/"
}
